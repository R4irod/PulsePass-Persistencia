            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"andrea\",\n  \"email\": \"andrea@email.com\",\n  \"firstName\": \"Andrea\",\n  \"lastName\": \"Gomez\",\n  \"phone\": \"3001234567\",\n  \"city\": \"Santa Marta\",\n  \"birthDate\": \"1999-05-20\",\n  \"password\": \"UnaFraseSegura2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"La respuesta NO trae hash ni password\", () => { const t = pm.response.text(); pm.expect(t).to.not.include(\"password\"); pm.expect(t).to.not.include(\"$2a$\"); });"
