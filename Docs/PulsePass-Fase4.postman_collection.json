              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.collectionVariables.get(\"tokenAndrea\");",
                  "const p = t.split(\".\");",
                  "const s = p[2]; const i = Math.floor(s.length/2);",
                  "const c = s[i] === \"A\" ? \"B\" : \"A\";",
                  "p[2] = s.substring(0,i) + c + s.substring(i+1);",
                  "pm.request.headers.upsert({key:\"Authorization\", value:\"Bearer \" + p.join(\".\")});"
                ]
              }
            }
          ]
        },
